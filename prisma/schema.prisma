// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

enum Role {
  STUDENT
  HELPER
}

model User {
  id          String   @id @default(cuid())
  email       String   @unique
  name        String?
  password    String
  role        Role     @default(STUDENT)
  // Profile fields
  profilePhoto String?
  bio          String?
  socialLinks  Json?    // Will store {linkedin: '', github: '', twitter: '', website: ''}
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
